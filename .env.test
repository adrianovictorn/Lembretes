# =============================================================================
# .env.example — Template de variáveis de ambiente para produção
# =============================================================================
# INSTRUÇÕES:
#   1. Copie este arquivo: cp .env.example .env
#   2. Preencha todos os valores marcados com lembrete_user
#   3. NUNCA faça commit do arquivo .env real (já está no .gitignore)
# =============================================================================

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_DB=lembrete-api
POSTGRES_USER=lembrete_user
POSTGRES_PASSWORD=TesteSenha123!

# ── JWT Secret ────────────────────────────────────────────────────────────────
# Gere um secret seguro com: openssl rand -base64 48
APP_JWT_SECRET=TestJwtSecretMuitoLongoParaTesteApenasNaoUsar123456

# ── CORS ──────────────────────────────────────────────────────────────────────
# Separe múltiplos domínios com vírgula
APP_CORS_ORIGINS=https://gamificacao.ddns.net,http://gamificacao.ddns.net
